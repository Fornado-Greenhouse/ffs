<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ffs.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <!-- @FFS_APP@ is rewritten by installer/install.sh to the
             absolute path of the installed FFS.app bundle (default
             $HOME/.local/Applications/FFS.app). The daemon binary
             must be invoked by its real path inside the bundle so
             macOS Code Signing Services resolves the embedded
             provisioning profile + Info.plist correctly; launchd's
             plist resolution doesn't follow symlinks into bundles
             (per task_35 / ADR-025). -->
        <string>@FFS_APP@/Contents/MacOS/ffs-daemon</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>FFS_DATA_DIR</key>
        <string>@HOME@/.ffs</string>
        <key>FFS_LOG</key>
        <string>info</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <!-- Restart on crash, but not on clean exit (SIGTERM). -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>@HOME@/.ffs/log/ffs-daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/.ffs/log/ffs-daemon.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
