---
{%- if claim.display_name %}
display_name: {{ claim.display_name }}
{%- endif -%}
{%- if claim.aliases %}{%- if claim.aliases | length > 0 %}
aliases: [{{ claim.aliases | join(sep=", ") }}]
{%- endif -%}{%- endif -%}
{%- if claim.work_email %}
work_email: {{ claim.work_email }}
{%- endif -%}
{%- if claim.personal_email %}
personal_email: {{ claim.personal_email }}
{%- endif -%}
{%- if claim.phone %}
phone: {{ claim.phone }}
{%- endif -%}
{%- if claim.organization %}
organization: {{ claim.organization }}
{%- endif -%}
{%- if claim.role %}
role: {{ claim.role }}
{%- endif -%}
{%- if claim.tier %}
tier: {{ claim.tier }}
{%- endif -%}
{%- if claim.pronouns %}
pronouns: {{ claim.pronouns }}
{%- endif %}
{%- if status_visible and status_report.windowed %}
status: {{ status }}
{%- endif %}
---{%- if status_visible and status_report.windowed and as_of_line %}
{{ as_of_line }}{% if status_marker %} {{ status_marker }}{% endif %}
{%- elif status_visible and status_report.windowed and status_marker %}
{{ status_marker }}
{%- endif %}
{% if claim.notes and claim.notes | length > 0 %}
## Notes
{% for note in claim.notes -%}
- {{ note }}
{% endfor -%}
{% endif -%}
{% if claim.tags and claim.tags | length > 0 %}
## Tags
{% for tag in claim.tags -%}
- {{ tag }}
{% endfor -%}
{% endif -%}
{% if claim.organizations and claim.organizations | length > 0 %}
## Organizations
{% for org in claim.organizations -%}
- {{ org }}
{% endfor -%}
{% endif -%}
{% if claim.history and claim.history | length > 0 %}
## History
{% for entry in claim.history -%}
- {{ entry }}
{% endfor -%}
{% endif -%}
{% if affiliations %}{% if affiliations | length > 0 %}
## Affiliations
{% for a in affiliations -%}
- {% if a.basename %}[[{{ a.basename }}|{{ a.display }}]]{% else %}{{ a.display }}{% endif %}: {{ a.title | default(value="affiliated") }} ({{ a.valid_from }} to {% if a.valid_to %}{{ a.valid_to }}{% else %}present{% endif %}){% if a.status %} [{{ a.status }}]{% endif %}
{% endfor -%}
{% endif %}{% endif -%}
{%- if status_visible and status_report.windowed and attestations | length > 0 %}

## Confirmed
{% for a in attestations -%}
- {{ a.attester_label }} ({{ a.basis_label }}) as of {{ a.as_of }}{% if a.source %}: {{ a.source }}{% endif %}
{% endfor %}
{%- endif -%}
