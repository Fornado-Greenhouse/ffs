---
{%- if claim.display_name %}
display_name: {{ claim.display_name }}
{%- endif -%}
{%- if claim.aliases %}{%- if claim.aliases | length > 0 %}
aliases: [{{ claim.aliases | join(sep=", ") }}]
{%- endif -%}{%- endif -%}
{%- if merged_from %}{%- if merged_from | length > 0 %}
merged_from: [{% for m in merged_from %}{% if not loop.first %}, {% endif %}"[[{{ m.basename }}|{{ m.display }}]]"{% endfor %}]
{%- endif -%}{%- endif -%}
{%- if claim.organization %}
organization: {% if organization_link %}"[[{{ organization_link.basename }}|{{ organization_link.display }}]]"{% else %}{{ claim.organization }}{% endif %}
{%- endif -%}
{%- if claim.role %}
role: {{ claim.role }}
{%- endif -%}
{%- if claim.team %}
team: {{ claim.team }}
{%- endif -%}
{%- if claim.location %}
location: {{ claim.location }}
{%- endif -%}
{%- if claim.pronouns %}
pronouns: {{ claim.pronouns }}
{%- endif %}
{%- if status_visible %}
status: {{ status }}
{%- endif %}
---{%- if status_visible and as_of_line %}
{{ as_of_line }}{% if status_marker %} {{ status_marker }}{% endif %}
{%- elif status_visible and status_marker %}
{{ status_marker }}
{%- endif %}
{% if claim.bio and claim.bio | length > 0 %}
## Bio
{% for line in claim.bio -%}
- {{ line }}
{% endfor -%}
{% endif -%}
{% if claim.mentions and claim.mentions | length > 0 %}
## Mentions
{% for m in claim.mentions -%}
- {{ m }}
{% endfor -%}
{% endif -%}
{% if affiliations %}{% if affiliations | length > 0 %}
## Affiliations
{% for a in affiliations -%}
- {% if a.basename %}[[{{ a.basename }}|{{ a.display }}]]{% else %}{{ a.display }}{% endif %}: {{ a.title | default(value="affiliated") }} ({{ a.valid_from }} to {% if a.valid_to %}{{ a.valid_to }}{% else %}present{% endif %}){% if a.status %} [{{ a.status }}]{% endif %}
{% endfor -%}
{% endif %}{% endif -%}
{%- if status_visible and attestations | length > 0 %}

## Confirmed
{% for a in attestations -%}
- {{ a.attester_label }} ({{ a.basis_label }}) as of {{ a.as_of }}{% if a.source %}: {{ a.source }}{% endif %}
{% endfor %}
{%- endif -%}
